# YouTube download settings
YTDLP_FORMAT=bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]
YTDLP_OUTDIR=./storage/downloads

# Transcription settings
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# FFmpeg settings
FFMPEG_THREADS=0

# Web interface
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# Output settings
OUTPUT_DIR=./storage/output
TEMP_DIR=./storage/temp

# Persistence (jobs, clips, templates)
DB_PATH=./storage/cortai.db

# Watermark
WATERMARK_IMAGE=./assets/watermark.png

# AI providers (selecao automatica de clipes, Fase 3)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# (As chaves também podem ser configuradas na tela /settings. Sem chaves, a seleção roda 100% local.)
